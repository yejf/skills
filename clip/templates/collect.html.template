<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>收藏</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
            background: #fafafa;
            color: #1a1a1a;
            padding: 3rem 2rem;
            line-height: 1.6;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .header {
            margin-bottom: 2.5rem;
        }

        .header h1 {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .header p {
            font-size: 0.85rem;
            color: #999;
            margin-top: 0.25rem;
        }

        .header code {
            font-family: "SF Mono", "Fira Code", monospace;
            font-size: 0.8rem;
            background: #f0f0f0;
            padding: 0.15rem 0.4rem;
            border-radius: 3px;
        }

        .stats {
            display: flex;
            gap: 3rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #e5e5e5;
        }

        .stat-item .value {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .stat-item .label {
            font-size: 0.75rem;
            color: #999;
            margin-top: 0.35rem;
        }

        .filters {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .filters input,
        .filters select {
            padding: 0.5rem 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 0.85rem;
            background: #fff;
            color: #1a1a1a;
            outline: none;
            transition: border-color 0.15s;
        }

        .filters input:focus,
        .filters select:focus {
            border-color: #1a1a1a;
        }

        .filters input[type="text"] {
            width: 280px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }

        thead th {
            text-align: left;
            font-size: 0.7rem;
            font-weight: 600;
            color: #999;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #e5e5e5;
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
        }

        thead th:hover {
            color: #1a1a1a;
        }

        thead th .arrow {
            font-size: 0.6rem;
            margin-left: 0.25rem;
            opacity: 0.4;
        }

        tbody td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.85rem;
            vertical-align: middle;
        }

        tbody tr:hover {
            background: #fafafa;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .col-id { color: #999; font-size: 0.8rem; width: 50px; }
        .col-date { color: #666; font-size: 0.8rem; white-space: nowrap; width: 100px; }
        .col-title { max-width: 320px; }
        .col-title a { color: #1a1a1a; text-decoration: none; font-weight: 500; }
        .col-title a:hover { text-decoration: underline; }
        .col-author { color: #666; font-size: 0.8rem; white-space: nowrap; }
        .col-source { color: #666; font-size: 0.8rem; white-space: nowrap; }
        .col-category { white-space: nowrap; }

        .col-category span {
            font-size: 0.75rem;
            padding: 0.15rem 0.5rem;
            border-radius: 3px;
            font-weight: 500;
        }

        .cat-tutorial { background: #e8f4fd; color: #0c5da5; }
        .cat-opinion { background: #fde8e8; color: #a50c0c; }
        .cat-news { background: #e8fde8; color: #0ca50c; }
        .cat-tech-article { background: #fdf0e8; color: #a55c0c; }
        .cat-research { background: #f0e8fd; color: #5c0ca5; }
        .cat-general { background: #f0f0f0; color: #666; }

        .col-words {
            text-align: right;
            color: #999;
            font-size: 0.8rem;
            font-variant-numeric: tabular-nums;
            width: 80px;
        }

        .col-links { width: 120px; white-space: nowrap; }

        .col-links a {
            font-size: 0.75rem;
            color: #999;
            text-decoration: none;
            margin-right: 0.75rem;
        }

        .col-links a:hover { color: #1a1a1a; }

        .empty {
            text-align: center;
            padding: 4rem 1rem;
            color: #ccc;
            font-size: 0.9rem;
        }

        .footer {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #e5e5e5;
            font-size: 0.75rem;
            color: #ccc;
            display: flex;
            justify-content: space-between;
        }

        @media (max-width: 768px) {
            body { padding: 1.5rem 1rem; }
            .stats { gap: 1.5rem; flex-wrap: wrap; }
            .stat-item .value { font-size: 1.25rem; }
            .filters { flex-direction: column; }
            .filters input[type="text"] { width: 100%; }
            .col-author, .col-source { display: none; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>收藏</h1>
            <p>通过 <code>/clip</code> 自动维护</p>
        </div>

        <div class="stats">
            <div class="stat-item">
                <div class="value" id="totalArticles">0</div>
                <div class="label">文章</div>
            </div>
            <div class="stat-item">
                <div class="value" id="totalWords">0</div>
                <div class="label">字数</div>
            </div>
            <div class="stat-item">
                <div class="value" id="totalCategories">0</div>
                <div class="label">分类</div>
            </div>
        </div>

        <div class="filters">
            <input type="text" id="searchInput" placeholder="搜索标题、作者、来源...">
            <select id="categoryFilter">
                <option value="">全部分类</option>
            </select>
        </div>

        <table>
            <thead>
                <tr>
                    <th onclick="sortTable('id')">序号<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('date')">日期<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('title')">标题<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('author')">作者<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('source')">来源<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('category')">分类<span class="arrow">&udarr;</span></th>
                    <th onclick="sortTable('word_count')">字数<span class="arrow">&udarr;</span></th>
                    <th>链接</th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
        </table>

        <div class="footer">
            <span>数据源: 资料库数据表（/clip 增量同步）</span>
            <span id="lastUpdate">-</span>
        </div>
    </div>

    <script>
        // 数据表 ID：首次资料库同步时由 AI 替换为真实值（来自 import_csv 返回的节点 id）
        var DATABASE_ID = '__CLIP_DATABASE_ID__';

        // 字段映射：key 为页面内部字段名，value 为数据表真实字段名。
        // 首次同步时由 AI 按服务端真实 schema 填充（通常与 CSV 表头一致）。
        var FIELD_MAP = __CLIP_FIELD_MAP__;

        var articles = [];
        var currentSort = { field: 'id', direction: 'desc' };
        var refreshTimer = null;

        function getDb() {
            try {
                if (window.__SMART_PAGE__ && window.__SMART_PAGE__.database) {
                    return window.__SMART_PAGE__.database;
                }
            } catch (e) {}
            return null;
        }

        // 兼容 text（string）与 url（{text, link}）两种返回形态
        function toText(v) {
            if (v && typeof v === 'object') return String(v.link || v.text || '');
            return String(v === null || v === undefined ? '' : v);
        }

        function toInt(v) {
            var n = parseInt(v, 10);
            return isNaN(n) ? 0 : n;
        }

        function mapRow(row) {
            return {
                id: toInt(raw(row, 'id')),
                date: toText(raw(row, 'date')).slice(0, 10),
                title: toText(raw(row, 'title')),
                author: toText(raw(row, 'author')),
                source: toText(raw(row, 'source')),
                category: toText(raw(row, 'category')),
                word_count: toInt(raw(row, 'word_count')),
                url: toText(raw(row, 'url'))
            };
        }

        function raw(row, key) {
            var v = row[FIELD_MAP[key]];
            return v === null || v === undefined ? '' : v;
        }

        // query 单次只回一页（上限 200），拉全量必须循环翻页（游标入参固定为 startCursor）
        function loadAll(db, startCursor, acc, guard) {
            acc = acc || [];
            guard = guard || 0;
            if (guard > 100) return Promise.resolve(acc);
            return db.query({ databaseId: DATABASE_ID, pageSize: 200, startCursor: startCursor })
                .then(function (r) {
                    acc = acc.concat(r.results || []);
                    var next = r.nextCursor;
                    if (r.hasMore && next && next !== startCursor && (r.results || []).length) {
                        return loadAll(db, next, acc, guard + 1);
                    }
                    return acc;
                });
        }

        function getCatClass(cat) {
            if (cat.indexOf('tutorial') >= 0) return 'cat-tutorial';
            if (cat.indexOf('opinion') >= 0) return 'cat-opinion';
            if (cat.indexOf('news') >= 0) return 'cat-news';
            if (cat.indexOf('tech') >= 0) return 'cat-tech-article';
            if (cat.indexOf('research') >= 0) return 'cat-research';
            return 'cat-general';
        }

        function setText(id, text) {
            document.getElementById(id).textContent = text;
        }

        function renderStats() {
            var total = articles.length;
            var words = 0;
            var cats = {};
            articles.forEach(function (a) {
                words += a.word_count;
                var c = a.category.split('【')[0];
                cats[c] = true;
            });

            setText('totalArticles', String(total));
            setText('totalWords', words.toLocaleString());
            setText('totalCategories', String(Object.keys(cats).length));
        }

        function renderCategoryFilter() {
            var seen = {};
            var list = [];
            articles.forEach(function (a) {
                if (!seen[a.category]) { seen[a.category] = true; list.push(a.category); }
            });
            var sel = document.getElementById('categoryFilter');
            while (sel.firstChild) sel.removeChild(sel.firstChild);
            var all = document.createElement('option');
            all.value = '';
            all.textContent = '全部分类';
            sel.appendChild(all);
            list.forEach(function (c) {
                var opt = document.createElement('option');
                opt.value = c;
                opt.textContent = c;
                sel.appendChild(opt);
            });
        }

        function showTableMessage(message) {
            var tbody = document.getElementById('tableBody');
            while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.colSpan = 8;
            td.className = 'empty';
            td.textContent = message;
            tr.appendChild(td);
            tbody.appendChild(tr);
        }

        function renderTable(data) {
            var tbody = document.getElementById('tableBody');
            while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
            if (!data.length) {
                showTableMessage('暂无数据');
                return;
            }
            data.forEach(function (a) {
                var tr = document.createElement('tr');

                var tdId = document.createElement('td');
                tdId.className = 'col-id';
                tdId.textContent = String(a.id);

                var tdDate = document.createElement('td');
                tdDate.className = 'col-date';
                tdDate.textContent = a.date;

                var tdTitle = document.createElement('td');
                tdTitle.className = 'col-title';
                var titleLink = document.createElement('a');
                titleLink.href = a.url;
                titleLink.target = '_blank';
                titleLink.rel = 'noopener';
                titleLink.textContent = a.title;
                tdTitle.appendChild(titleLink);

                var tdAuthor = document.createElement('td');
                tdAuthor.className = 'col-author';
                tdAuthor.textContent = a.author;

                var tdSource = document.createElement('td');
                tdSource.className = 'col-source';
                tdSource.textContent = a.source;

                var tdCat = document.createElement('td');
                tdCat.className = 'col-category';
                var catSpan = document.createElement('span');
                catSpan.className = getCatClass(a.category);
                catSpan.textContent = a.category;
                tdCat.appendChild(catSpan);

                var tdWords = document.createElement('td');
                tdWords.className = 'col-words';
                tdWords.textContent = a.word_count.toLocaleString();

                var tdLinks = document.createElement('td');
                tdLinks.className = 'col-links';
                var srcLink = document.createElement('a');
                srcLink.href = a.url;
                srcLink.target = '_blank';
                srcLink.rel = 'noopener';
                srcLink.textContent = '原文';
                tdLinks.appendChild(srcLink);

                tr.appendChild(tdId);
                tr.appendChild(tdDate);
                tr.appendChild(tdTitle);
                tr.appendChild(tdAuthor);
                tr.appendChild(tdSource);
                tr.appendChild(tdCat);
                tr.appendChild(tdWords);
                tr.appendChild(tdLinks);
                tbody.appendChild(tr);
            });
        }

        function applySort() {
            var f = currentSort.field;
            var d = currentSort.direction === 'asc' ? 1 : -1;
            articles.sort(function (a, b) {
                var va = a[f], vb = b[f];
                if (f === 'id' || f === 'word_count') { va = toInt(va); vb = toInt(vb); }
                return va > vb ? d : (va < vb ? -d : 0);
            });
            renderTable(articles);
        }

        function sortTable(field) {
            if (currentSort.field === field) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.field = field;
                currentSort.direction = 'asc';
            }
            applySort();
        }

        function filterData() {
            var q = document.getElementById('searchInput').value.toLowerCase();
            var cat = document.getElementById('categoryFilter').value;
            var filtered = articles.filter(function (a) {
                var matchQ = !q || a.title.toLowerCase().indexOf(q) >= 0 || a.author.toLowerCase().indexOf(q) >= 0 || a.source.toLowerCase().indexOf(q) >= 0;
                var matchC = !cat || a.category === cat;
                return matchQ && matchC;
            });
            renderTable(filtered);
        }

        function loadData() {
            var db = getDb();
            if (!db) {
                showTableMessage('请在 WorkBuddy 资料库中打开此页面以加载数据');
                return;
            }
            showTableMessage('加载中...');
            loadAll(db)
                .then(function (rows) {
                    articles = (rows || []).map(mapRow);
                    renderStats();
                    renderCategoryFilter();
                    applySort();
                    setText('lastUpdate', '更新于 ' + new Date().toLocaleString('zh-CN', { dateStyle: 'medium', timeStyle: 'short' }));
                })
                .catch(function () {
                    showTableMessage('数据加载失败，请稍后重试');
                });
        }

        document.getElementById('searchInput').addEventListener('input', filterData);
        document.getElementById('categoryFilter').addEventListener('change', filterData);

        // 订阅数据表变更：/clip 增量写入后自动刷新（300ms 去抖）
        var __db = getDb();
        if (__db && typeof __db.onUpdated === 'function') {
            __db.onUpdated(function (payload) {
                var ids = (payload && payload.databaseIds) || [];
                if (ids.indexOf(DATABASE_ID) === -1) return;
                if (refreshTimer) clearTimeout(refreshTimer);
                refreshTimer = setTimeout(loadData, 300);
            });
        }

        loadData();
    </script>
</body>
</html>
